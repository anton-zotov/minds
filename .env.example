# Host/server configuration only. Never expose these through frontend environment variables.
OPENROUTER_API_KEY=
OPENROUTER_GENERATIVE_MODEL=openai/gpt-6-luna
# Typed planning judgments use Jev's dedicated decisions endpoint.
OPENROUTER_DECISION_MODEL=typesafe/jev-1.13
# Generative belief proposals in Playbox; legacy combined appraisal in the foundation example.
OPENROUTER_APPRAISAL_MODEL=openai/gpt-6-luna
# Optional Jev override for sequential belief and emotional judgments.
OPENROUTER_APPRAISAL_DECISION_MODEL=
# Optional planning overrides. Generation falls back to GENERATIVE_MODEL,
# then APPRAISAL_MODEL; decisions fall back to DECISION_MODEL, then typesafe/jev-1.13.
OPENROUTER_INTENTION_GENERATION_MODEL=
OPENROUTER_INTENTION_DECISION_MODEL=
# Optional action role overrides; generation/expression use the generative model,
# structured selection uses the effective Jev decision model.
OPENROUTER_ACTION_GENERATION_MODEL=
OPENROUTER_ACTION_DECISION_MODEL=
OPENROUTER_ACTION_EXPRESSION_MODEL=
